# Local development only. Choose a unique password before starting PostgreSQL.
POSTGRES_USER=ecommerce
POSTGRES_DB=ecommerce
POSTGRES_PASSWORD=
POSTGRES_PORT=5432
POSTGRES_HOST=127.0.0.1
RAW_DATA_DIR=data/raw
INGEST_BATCH_SIZE=1000
DB_CONNECT_TIMEOUT=5
DB_STATEMENT_TIMEOUT_MS=60000
DB_CONNECT_ATTEMPTS=3
# Optional Phase 3 SQL Server source (generated locally; never commit real values).
MSSQL_SA_PASSWORD=
SQLSERVER_PASSWORD=
SQLSERVER_HOST=127.0.0.1
SQLSERVER_PORT=1433
# Generated by scripts/init_airflow_db.py; actual values belong only in .env.
AIRFLOW_DB_PASSWORD=
AIRFLOW_ADMIN_PASSWORD=
AIRFLOW_JWT_SECRET=
AIRFLOW_FERNET_KEY=
AIRFLOW_PORT=8080
